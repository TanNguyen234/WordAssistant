          "required": true,
          "page_break_before": true
        },
        {
          "title": "CHƯƠNG 3. QUẢN LÝ PHẠM VI VÀ WBS",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "CHƯƠNG 4. QUẢN LÝ TIẾN ĐỘ VÀ CPM",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "CHƯƠNG 5. QUẢN LÝ NGUỒN LỰC VÀ CHI PHÍ",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "CHƯƠNG 6. QUẢN LÝ RỦI RO",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "CHƯƠNG 7. QUẢN LÝ CHẤT LƯỢNG VÀ KIỂM THỬ",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "CHƯƠNG 8. TRUYỀN THÔNG, THAY ĐỔI VÀ TRELLO",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "CHƯƠNG 9. THIẾT KẾ VÀ BIỂU ĐỒ DRAW.IO",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "CHƯƠNG 10. NGHIỆM THU VÀ ĐÓNG DỰ ÁN",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "KẾT LUẬN VÀ KIẾN NGHỊ",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "TÀI LIỆU THAM KHẢO",
          "level": 1,
          "required": true,
          "page_break_before": true
        },
        {
          "title": "PHỤ LỤC",
          "level": 1,
          "required": true,
          "page_break_before": true
        }
      ],
      "citations": {
        "style": "numeric",
        "bibliography_order": "citation_order",
        "minimum_references": 4,
        "prefer_primary_source": true,
        "require_reviewed_sources": true
      },
      "header_footer": {
        "footer_right": "page_number",
        "page_number_start": "introduction",
        "front_matter_page_number_format": "lowerRoman"
      },
      "captions": {
        "figure_labels": [
          {
            "display": "HÌNH",
            "sequence": "Hinh"
          }
        ],
        "table_label": {
          "display": "BẢNG",
          "sequence": "Bang"
        }
      }
    }
  }
}
