{
  "id": "generic-lms-project-report",
  "name": "Generic LMS course report",
  "version": 1,
  "source_policy": "user-profile-wins",
  "variants": {
    "default": {
      "page": {
        "size": "A4",
        "width_cm": 21,
        "height_cm": 29.7,
        "margins_cm": {
          "top": 2.5,
          "bottom": 2.5,
          "left": 3,
          "right": 2
        },
        "one_sided": true,
        "allow_mixed_orientation": true
      },
      "typography": {
        "body_font": "Times New Roman",
        "body_size_pt": 12,
        "line_spacing": 1.15,
        "paragraph_spacing_after_pt": 6,
        "styles": {
          "title": {
            "font": "Times New Roman",
            "size_pt": 20,
            "bold": true,
            "alignment": "center"
          },
          "heading1": {
            "font": "Times New Roman",
            "size_pt": 16,
            "bold": true,
            "space_before_pt": 10,
            "space_after_pt": 6
          },
          "heading2": {
            "font": "Times New Roman",
            "size_pt": 14,
            "bold": true,
            "space_before_pt": 8,
            "space_after_pt": 4
          },
          "heading3": {
            "font": "Times New Roman",
            "bold": true
          },
          "Normal": {
            "font": "Times New Roman",
            "alignment": "justify",
            "line_spacing": 1.15,
            "space_after_pt": 6
          }
        }
      },
      "front_matter": [
        "cover",
        "abstract",
        "table_of_contents",
        "list_of_figures",
        "list_of_tables"
      ],
      "front_matter_titles": {
        "abstract": "TÓM TẮT",
        "table_of_contents": "MỤC LỤC",
        "list_of_figures": "DANH MỤC HÌNH",
        "list_of_tables": "DANH MỤC BẢNG"
      },
      "cover": {
        "institution_lines": [
          "Chưa cung cấp tên trường/đơn vị đào tạo",
          "Chưa cung cấp khoa/bộ môn"
        ],
        "document_type": "TIỂU LUẬN MÔN HỌC",
        "title_prefix": "BÁO CÁO",
        "metadata_fields": [
          {
            "label": "Học phần",
            "value_key": "course_name",
            "default": "Quản lý dự án phần mềm"
          },
          {
            "label": "Sinh viên / nhóm",
            "value_key": "student",
            "default": "[Bổ sung thông tin thật]"
          },
          {
            "label": "Mã số",
            "value_key": "student_id",
            "default": "[Bổ sung]"
          },
          {
            "label": "Lớp học phần",
            "value_key": "class_or_cohort",
            "default": "[Bổ sung]"
          },
          {
            "label": "Giảng viên hướng dẫn",
            "value_key": "supervisor",
            "default": "[Bổ sung]"
          }
        ],
        "location_year": "2026",
        "styles": {
          "institution": "Normal",
          "faculty": "Normal",
          "document_type": "Normal",
          "title": "Title",
          "metadata": "Normal",
          "location_year": "Normal"
        }
      },
      "section_blueprint": [
        {
          "title": "MỞ ĐẦU",
          "level": 1,
          "required": true,
          "page_break_before": false
        },
        {
